# =============================================================================
# Neotree Data Pipeline -- .gitignore
# =============================================================================
# This repository contains CODE, REFERENCE DICTIONARIES and DOCUMENTATION only.
# Patient-level data and credentials must NEVER be committed.
# =============================================================================

# --- Operating system junk ---------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# --- R session / project files -----------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj
.Rproj.user/
.Renviron

# --- Pipeline run artifacts (regenerated on every run) -----------------------
cleaning_pipeline_R/output/
*.log

# --- Raw and processed patient data (NEVER COMMIT) ---------------------------
# Ignore EVERYTHING dropped into the pipeline input folder, whatever the file
# type, keeping only the placeholder that preserves the directory in git.
cleaning_pipeline_R/input/*
!cleaning_pipeline_R/input/.gitkeep

# NA-coded data extracts
*_na_coded.csv
*_na_coded.xlsx

# --- Credentials / secrets (NEVER COMMIT) ------------------------------------
# Artifactory tokens belong in install_packages_dsh.r locally only -- the
# committed copy must keep the YOUR_ARTIFACTORY_TOKEN_HERE placeholder.
.env
*.pem
*.key
secrets.*
